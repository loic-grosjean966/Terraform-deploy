# MODÈLE de fichier de variables — à copier, pas à modifier directement :
#
#     cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars contient les identifiants Prism Central et n'est PAS versionné
# (exclu par .gitignore). Ne jamais y mettre de vraies valeurs dans ce fichier-ci,
# qui est committé.
#
# Où trouver les UUID ? Dans Prism Central, ouvrez l'entité : l'UUID est dans l'URL.
# En SSH sur une CVM : `ncli cluster info`, `acli net.list`, `acli image.list`.
# Attention à ne pas laisser d'espace parasite en début ou fin d'UUID au copier-coller.

# --- Connexion à Prism Central -------------------------------------------------------

nutanix_username = "your-username"
nutanix_password = "your-password"

# VIP du cluster Prism Central — jamais l'adresse d'une CVM individuelle.
# UNIQUEMENT l'IP ou le FQDN : pas de "https://", pas de port ici (il est
# renseigné séparément ci-dessous). Une URL complète fait échouer les appels API.
nutanix_endpoint = "prism.example.com"
nutanix_port     = 9440

# true tant que Prism Central utilise un certificat auto-signé.
nutanix_insecure = true

# --- Entités Nutanix existantes (à référencer, elles ne sont pas créées ici) ----------

nutanix_cluster_uuid = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" # cluster d'exécution
nutanix_image_uuid   = "11111111-2222-3333-4444-555555555555" # image OS à cloner
nutanix_subnet_uuid  = "ffffffff-0000-1111-2222-333333333333" # subnet des VMs

# Pas de nutanix_storage_container_uuid : au clonage d'une image, Nutanix place le
# disque dans le même conteneur que l'image source, sans que ce soit configurable.

# --- Compte de secours (optionnel) ----------------------------------------------------
#
# Compte local créé sur TOUTES les VMs, utilisable uniquement depuis la console Prism :
# l'authentification par mot de passe reste désactivée côté SSH. Sert à réparer une VM
# dont la clé ne fonctionne plus. Laisser le hachage vide n'en crée aucun.
#
# Générer le hachage — la saisie est masquée et n'entre pas dans l'historique shell :
#     openssl passwd -6
#
# Ce hachage est lisible via l'API Nutanix, donc cassable hors-ligne : mot de passe long
# et aléatoire, rotation régulière. Voir README, section "Modèle d'accès".

# break_glass_user          = "secours"
# break_glass_password_hash = "$6$RemplacerParLeHachageGénéré"

# --- Intégration Active Directory (optionnel) -----------------------------------------
#
# Prépare les VMs à l'authentification par comptes de domaine (paquets realmd/sssd,
# droits sudo au groupe, création des répertoires personnels).
#
# La jonction elle-même reste MANUELLE, une fois par VM après le premier démarrage :
#     sudo realm join --user=<compte-de-jonction> EXEMPLE.PRIV
#     sudo realm permit -g 'GG_Admins_Linux@exemple.priv'
#
# Éviter les espaces dans le nom du groupe : ils imposent un échappement `\_` que HCL
# refuse, et qu'il faut alors doubler ("Admins\\_Systeme").

# ad_domain      = "exemple.priv"
# ad_admin_group = "GG_Admins_Linux"

# --- VMs à déployer -------------------------------------------------------------------
#
# La clé est le nom de la VM dans Nutanix (et son hostname, en minuscules). Les champs
# omis prennent les valeurs par défaut (2 vCPU, 8 Go de RAM, 40 Go de disque, allumée)
# — voir variables.tf.
#
# Le disque prend d'abord la taille de l'image au clonage (l'API l'impose) ; un second
# `tofu apply`, sans rien changer, l'agrandit ensuite à disk_size_bytes.
#
# ATTENTION : renommer une clé équivaut à détruire la VM puis à en recréer une autre.
#
# ssh_keys est le seul champ réellement indispensable : la personnalisation cloud-init
# s'applique de toute façon (hostname, clavier, préparation AD), mais sans clé publique
# la VM est inaccessible — le compte créé n'a pas de mot de passe. Seul un compte de
# secours déclaré plus haut permettrait encore d'y entrer, par la console.
# Récupérer sa clé publique : Get-Content $env:USERPROFILE\.ssh\id_ed25519.pub
# La coller en entier, sur une seule ligne, commentaire final compris.

vms = {
  hdvdevops = {
    description = "Machine virtuelle sous Linux pour Intranet DevOps"

    ssh_keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExempleDeCléPubliqueÀRemplacer vous@poste",
    ]
  }

  hdvdevops2 = {
    description = "Deuxième machine virtuelle Nutanix"

    ssh_keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExempleDeCléPubliqueÀRemplacer vous@poste",
    ]

    # Exemple de personnalisation du gabarit :
    # num_sockets          = 2
    # num_cores_per_socket = 4
    # memory_size_bytes    = 17179869184 # 16 Go
    # disk_size_bytes      = 53687091200 # 50 Go

    # Compte créé par cloud-init. À adapter à la distribution de l'image :
    # "ubuntu" (défaut), "debian", "rocky", "almalinux", "cloud-user"...
    # cloud_init_user = "ubuntu"
  }
}
